# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
# If using Docker: docker compose up -d
# Default URL:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/payment_gap_compliance?schema=public

# In local environments without running PostgreSQL, SQLite can also be used:
# DATABASE_URL=file:./dev.db

# Authentication Security
JWT_SECRET=demo-dev-jwt-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
